# ==============================================================================
# SIMKAS UKM STMIK Lombok - Environment Configuration Template
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin file ini menjadi .env di backend: cp .env.example .env
# 2. File .env sudah otomatis terdaftar di .gitignore dan TIDAK AKAN ter-commit ke git.
# ==============================================================================

PORT=5000
JWT_SECRET=ganti_dengan_rahasia_jwt_acak_yang_panjang_dan_kuat_2026

# ==============================================================================
# 1. ENVIRONMENT: DEVELOPMENT (LOKAL)
# ==============================================================================
# Untuk development di komputer lokal:
# CUKUP KOSONGKAN atau BERI TANDA PAGAR (#) pada DATABASE_URL di bawah ini.
# Backend SIMKAS akan otomatis beralih ke SQLite lokal (database.sqlite) yang
# cepat, offline, zero-config, dan aman tanpa mengotori database cloud.
#
# DATABASE_URL=

# ==============================================================================
# 2. ENVIRONMENT: STAGING / SUPABASE DEV (OPSIONAL)
# ==============================================================================
# Jika ingin menghubungkan lokal ke instance Supabase khusus Dev (misal: simkas-dev):
# DATABASE_URL=postgresql://postgres.dev_ref:dev_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ==============================================================================
# 3. ENVIRONMENT: PRODUCTION (VERCEL + SUPABASE PROD)
# ==============================================================================
# JANGAN cantumkan kredensial production di file lokal!
# Konfigurasikan variabel berikut langsung di dashboard Vercel:
# (Vercel Project Dashboard > Settings > Environment Variables):
#
# - DATABASE_URL = Connection string Supabase Production (Port 6543 Pooler)
# - JWT_SECRET   = Kunci enkripsi acak khusus production
# - NODE_ENV     = production
# ==============================================================================
